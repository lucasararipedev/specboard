# Tudo aqui é opcional. Copie para .env só se quiser mudar algo: cp .env.example .env

# Porta na sua máquina. Se mudar, ajuste SPECBOARD_PUBLIC_URL junto.
SPECBOARD_PORT=8787

# URL que a IA usa e manda para você nos links de board e card.
SPECBOARD_PUBLIC_URL=http://localhost:8787

# 127.0.0.1 = só esta máquina. Use 0.0.0.0 para abrir na rede (aí defina um token!).
SPECBOARD_BIND=127.0.0.1

# Se definido, a API exige "Authorization: Bearer <token>". Gere um com: openssl rand -hex 24
SPECBOARD_TOKEN=

# Dias sem atualização para um card em "doing"/"blocked" aparecer como parado no briefing.
SPECBOARD_STALE_DAYS=3

# Outros nomes/IPs aceitos além de localhost, 127.0.0.1 e o host da SPECBOARD_PUBLIC_URL (separe por vírgula).
# Pedidos com outro Host são recusados (proteção contra DNS rebinding).
SPECBOARD_ALLOWED_HOSTS=
