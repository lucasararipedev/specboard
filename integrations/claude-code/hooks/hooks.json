{
  "description": "Liga o chat ao Specboard no começo, dá sinal de vida a cada resposta e desliga ao fechar",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "curl -s --max-time 3 -X POST -H \"Content-Type: application/json\" -H \"Authorization: Bearer ${SPECBOARD_TOKEN:-}\" --data-binary @- \"${SPECBOARD_URL:-http://localhost:8787}/api/hooks/claude-code\" || true", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "curl -s --max-time 3 -X POST -H \"Content-Type: application/json\" -H \"Authorization: Bearer ${SPECBOARD_TOKEN:-}\" --data-binary @- \"${SPECBOARD_URL:-http://localhost:8787}/api/hooks/claude-code\" || true", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "curl -s --max-time 3 -X POST -H \"Content-Type: application/json\" -H \"Authorization: Bearer ${SPECBOARD_TOKEN:-}\" --data-binary @- \"${SPECBOARD_URL:-http://localhost:8787}/api/hooks/claude-code\" || true", "timeout": 5 }] }]
  }
}
